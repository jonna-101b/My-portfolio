# Server Port (Render provides process.env.PORT automatically)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Secrets (generate strong random strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars

# Portfolio Admin Notifications & Email
MY_GMAIL=your_email@gmail.com
RESEND_API_KEY=re_your_resend_api_key_here

# Initial Admin Credentials
MY_PORTFOLIO_PASSWORD=your_strong_admin_password
MY_NICKNAME=YourName

# Frontend origin allowed for CORS requests (comma-separated if multiple)
# e.g. https://your-portfolio.vercel.app
FRONTEND_URL=https://your-portfolio.vercel.app
